{
  "id": "ByteValley.DataCollection",
  "name": "九号·数据",
  "author": "@QinyRui",
  "description": "九号智能电动车账号凭证采集与管理（稳定版）",
  "icon": "https://raw.githubusercontent.com/QinyRui/QYR-/Q/IMG_1706.png",
  "repo": "https://t.me/JiuHaoAPP",
  "updateUrl": "https://raw.githubusercontent.com/QinyRui/QYR-/jiuhao/Ninebot.boxjs.json",
  "apps": [
    {
      "id": "DataCollection.Ninebot",
      "name": "九号小组件",
      "keys": [
        "#ComponentService",
        "ninebot.authorization",
        "ninebot.deviceId",
        "ninebot.userAgent",
        "ninebot.titlePrefix",
        "ninebot.notify",
        "ninebot.autoOpenBox",
        "ninebot.notifyFail",
        "ninebot.logLevel",
        "ninebot.lastCaptureAt",
        "ninebot.captureEnable",
        "ninebot.autoRepair",
        "ninebot.vehicleSn",
        "ninebot.batterySoc",
        "ninebot.mileage",
        "ninebot.totalMileage",
        "ninebot.lockStatus",
        "ninebot.batteryTemp",
        "ninebot.speed",
        "ninebot.vehicleLastUpdate"
      ],
      "settings": [
        {
          "id": "ninebot.captureEnable",
          "name": "自动抓包开关",
          "val": "true",
          "type": "select",
          "items": [
            { "key": "true", "label": "开启" },
            { "key": "false", "label": "关闭" }
          ]
        },
        {
          "id": "ninebot.authorization",
          "name": "Authorization",
          "val": "",
          "type": "text",
          "isSecret": true
        },
        {
          "id": "ninebot.deviceId",
          "name": "DeviceId",
          "val": "",
          "type": "text",
          "isSecret": true
        },
        {
          "id": "ninebot.userAgent",
          "name": "User-Agent",
          "val": "Ninebot/3620 CFNetwork Darwin",
          "type": "text"
        },
        {
          "id": "ninebot.notify",
          "name": "通知开关",
          "val": "true",
          "type": "select",
          "items": [
            { "key": "true", "label": "开启" },
            { "key": "false", "label": "关闭" }
          ]
        }
      ]
    }
  ],
  "rewrite": [
    {
      "name": "九号 BoxJs 跨域",
      "script": "const res={headers:{...$response.headers,\"Access-Control-Allow-Origin\":\"*\"},body:$response.body};$done(res);",
      "match": "https://raw.githubusercontent.com/QinyRui/QYR-/jiuhao/Ninebot.boxjs.json",
      "type": "response"
    },
    {
      "name": "九号车辆数据抓取（稳定版）",
      "type": "response",
      "match": "^https://(api-ninebot\\.9fevs\\.com|api-jhcx.*\\.ninebot\\.com)/.*/device/(status|realTimeData)",
      "script": "const enable=$persistentStore.read(\"ninebot.captureEnable\");if(enable!==\"true\"){$done({});return;}const body=$response.body;if(!body){$done({});return;}try{const json=JSON.parse(body);const d=json.data||json.result||json;if(!d){$done({});return;}const last=$persistentStore.read(\"ninebot.vehicleLastUpdate\");if(last&&Date.now()-new Date(last).getTime()<30000){$done({});return;}const safe=(v)=>(v===undefined||v===null)?\"\":String(v);$persistentStore.write(safe(d.sn||d.vehicleSn),'ninebot.vehicleSn');$persistentStore.write(safe(d.batterySoc),'ninebot.batterySoc');$persistentStore.write(safe(d.mileage),'ninebot.mileage');$persistentStore.write(safe(d.totalMileage),'ninebot.totalMileage');$persistentStore.write(safe(d.lockStatus),'ninebot.lockStatus');$persistentStore.write(safe(d.batteryTemp),'ninebot.batteryTemp');$persistentStore.write(safe(d.speed),'ninebot.speed');$persistentStore.write(new Date().toISOString(),'ninebot.vehicleLastUpdate');}catch(e){}$done({});"
    }
  ]
}